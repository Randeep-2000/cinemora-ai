# Local SQLite database; Prisma stores it in ./data/cinemora.db
DATABASE_URL="file:../data/cinemora.db"

# Replace with at least 32 random bytes before deploying.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
APP_URL="http://localhost:3000"

# Optional. If omitted, real screenplay generation is marked setup-required.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Optional. Set this to enable server-side FFmpeg exports.
FFMPEG_PATH="ffmpeg"
MAX_UPLOAD_MB="25"
